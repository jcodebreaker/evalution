# Any OpenAI-compatible model; a local Ollama by default, no paid model needed.
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=local
MODEL=llama3.2
# evalution's own Phoenix (evalution serve prints where it runs).
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006
PHOENIX_PROJECT_NAME=evalution-memory-agent
